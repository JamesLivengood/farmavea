<% content_for :title, "Conversaciones — Farmavea" %>

<%# Reloads the list periodically so a new conversation shows up without the
    operator having to refresh. Turbo replaces the body, so scroll position and any
    open dropdown survive. %>
<div data-controller="auto-refresh" data-auto-refresh-interval-value="20000"></div>

<% online = ChatStatus.online? %>
<div class="mb-5 flex items-center justify-between gap-4 bg-white border border-slate-200 rounded-xl px-4 py-3">
  <div class="flex items-center gap-2">
    <span class="w-2 h-2 rounded-full <%= online ? "bg-emerald-500" : "bg-slate-300" %>"></span>
    <span class="text-sm font-medium text-slate-900">
      <%= online ? "En línea" : "Desconectado" %>
    </span>
    <span class="text-xs text-slate-400">
      <%= online ? "los visitantes ven que puedes responder" : "se les pide dejar correo o teléfono" %>
    </span>
  </div>
  <%# Also settable from Telegram by sending "online" or "offline". %>
  <%= button_to online ? "Ponerme desconectado" : "Ponerme en línea",
        toggle_status_admin_chats_path(online: online ? "0" : "1"),
        class: "text-sm font-semibold rounded-lg px-3 py-1.5 transition-colors #{online ? "bg-slate-100 hover:bg-slate-200 text-slate-700" : "bg-emerald-600 hover:bg-emerald-700 text-white"}" %>
</div>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Conversaciones</h1>
  <p class="text-slate-500 text-sm mt-1">
    <%= pluralize(@total, "conversación", plural: "conversaciones") %> en total.
    Se eliminan automáticamente después de <%= ChatConversation::RETENTION.inspect %>.
  </p>
</div>

<% if @conversations.empty? %>
  <div class="bg-white border border-dashed border-slate-300 rounded-2xl p-12 text-center text-slate-500">
    Todavía no hay mensajes.
  </div>
<% else %>
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100">
    <% @conversations.each do |conversation| %>
      <% unread = conversation.unread_count %>
      <%= link_to admin_chat_path(conversation),
            class: "flex items-start gap-3 p-4 hover:bg-slate-50 transition-colors" do %>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <% if unread.positive? %>
              <span class="bg-emerald-600 text-white text-[11px] font-bold rounded-full px-2 py-0.5">
                <%= unread %> sin leer
              </span>
            <% end %>
            <span class="text-xs text-slate-400">
              <%= conversation.last_message_at&.strftime("%d/%m %H:%M") %>
            </span>
          </div>
          <p class="text-sm text-slate-800 mt-1 truncate">
            <%= conversation.messages.last&.body %>
          </p>
          <% if conversation.visitor_email.present? || conversation.visitor_phone.present? %>
            <p class="text-xs text-slate-400 mt-0.5"><%= conversation.contact_line %></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="flex items-center justify-between mt-5 text-sm">
      <% if @page > 1 %>
        <%= link_to "← Más recientes", admin_chats_path(page: @page - 1),
              class: "text-emerald-700 hover:text-emerald-800 font-medium" %>
      <% else %>
        <span></span>
      <% end %>

      <span class="text-slate-400 text-xs">Página <%= @page %> de <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to "Más antiguas →", admin_chats_path(page: @page + 1),
              class: "text-emerald-700 hover:text-emerald-800 font-medium" %>
      <% else %>
        <span></span>
      <% end %>
    </nav>
  <% end %>
<% end %>
