<% content_for :title, "#{@medication.display_strength} — Farmavea" %>
<% content_for :meta_title, "#{@medication.display_strength} — precios en Morelia" %>
<% content_for :meta_description, medication_share_description(@medication, @offers) %>

<%# py-2 -ml-1 px-1 keeps this at a comfortable touch size on a phone - it measured
    20px tall, and it's the main way back from a medication page. %>
<%= link_to root_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-emerald-700 transition-colors mb-4 py-2 px-1 -ml-1" do %>
  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
  </svg>
  Volver
<% end %>

<div class="mb-8">
  <div class="flex items-center gap-3 flex-wrap">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900"><%= @medication.display_strength %></h1>
    <% if @medication.requires_prescription %>
      <span class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-amber-700 bg-amber-50 ring-1 ring-inset ring-amber-200 rounded-full px-2.5 py-1">
        Requiere receta médica
      </span>
    <% end %>
  </div>
  <p class="text-slate-500 mt-1">Comparando precios en <%= @city %></p>
</div>

<% if @offers.empty? %>
  <div class="bg-white border border-dashed border-slate-300 rounded-2xl p-12 text-center text-slate-500">
    No hay precios disponibles hoy para este medicamento en <%= @city %>.
  </div>
<% else %>
  <%# We have no stock feed from any pharmacy, so availability is genuinely unknown
      to us. Saying so plainly matters more here than on other pages - this is where
      someone decides where to go buy. %>
  <div class="flex items-start gap-2.5 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-5">
    <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z" />
    </svg>
    <p class="text-sm text-amber-900 leading-relaxed">
      No podemos confirmar la disponibilidad. Consulta directamente con la farmacia
      antes de acudir.
    </p>
  </div>

  <div class="space-y-3">
    <% @offers.each_with_index do |offer, index| %>
      <% cheapest = index.zero? %>
      <div class="flex items-center gap-4 bg-white rounded-xl p-5 transition-all <%= cheapest ? 'border-2 border-emerald-400 shadow-md shadow-emerald-900/5' : 'border border-slate-200' %>">
        <div class="flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold shrink-0 <%= cheapest ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-500' %>">
          <%= index + 1 %>
        </div>

        <div class="min-w-0 flex-1">
          <% if cheapest %>
            <span class="inline-block text-[11px] font-semibold uppercase tracking-wide text-emerald-700 bg-emerald-50 ring-1 ring-inset ring-emerald-200 rounded-full px-2 py-0.5 mb-1.5">
              Más barato
            </span>
          <% end %>
          <div class="flex items-baseline gap-2 flex-wrap">
            <p class="font-semibold text-slate-900"><%= offer.pharmacy.name %></p>
            <% if offer.raw_listing&.pack_quantity.to_i > 1 %>
              <span class="text-xs font-medium text-slate-500 bg-slate-100 rounded-full px-2 py-0.5">
                <%= format_pack_size(offer) %>
              </span>
            <% end %>
          </div>
          <% if offer.raw_listing&.raw_name.present? %>
            <%# Wraps to two lines rather than truncating: on a phone a single-line
                truncate cut off exactly the part that distinguishes one listing from
                another (pack size, brand, presentation). %>
            <p class="text-sm text-slate-500 line-clamp-2"><%= offer.raw_listing.raw_name %></p>
          <% end %>
          <% if offer.raw_listing&.product_url.present? %>
            <%# py-2 -mb-1 gives this link a comfortable touch height (it measured 16px
                tall on a phone, well under the ~44px guideline) without adding visible
                space between the rows. %>
            <%= link_to offer.raw_listing.product_url, target: "_blank", rel: "noopener",
                  class: "inline-flex items-center gap-1 text-xs text-slate-400 hover:text-emerald-600 transition-colors py-2 -mb-1" do %>
              Ver producto
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            <% end %>
          <% end %>
        </div>

        <div class="text-right shrink-0">
          <p class="text-xl font-extrabold text-slate-900"><%= format_price(offer.price) %></p>
          <% if offer.price_per_pill.present? %>
            <p class="text-xs font-bold text-slate-700 mt-0.5"><%= format_price_per_pill(offer) %></p>
          <% end %>
          <% if offer.price_per_mg.present? %>
            <p class="text-xs text-slate-400 mt-0.5"><%= format_price_per_mg(offer.price_per_mg) %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
