<%# locals: offer %>
<%= link_to medication_path(offer.medication), class: "group block bg-white rounded-xl border border-slate-200 p-5 hover:border-emerald-300 hover:shadow-md hover:shadow-emerald-900/5 transition-all" do %>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <span class="inline-block text-[11px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full <%= pharmacy_badge_classes(offer.pharmacy) %>">
        <%= offer.pharmacy.name %>
      </span>
      <p class="font-semibold text-slate-900 mt-2 leading-snug group-hover:text-emerald-700 transition-colors">
        <%= offer.medication.display_strength %>
      </p>
    </div>
    <div class="text-right shrink-0">
      <p class="text-xl font-extrabold text-slate-900"><%= format_price(offer.price) %></p>
      <% if offer.price_per_pill.present? %>
        <p class="text-xs font-bold text-slate-700 mt-0.5"><%= format_price_per_pill(offer) %></p>
      <% end %>
      <% if offer.price_per_mg.present? %>
        <p class="text-xs text-slate-400 mt-0.5"><%= format_price_per_mg(offer.price_per_mg) %></p>
      <% end %>
    </div>
  </div>
<% end %>
