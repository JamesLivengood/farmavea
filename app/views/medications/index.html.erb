<% content_for :title, "Farmavea — Precios de medicamentos hoy" %>

<div class="mb-10">
  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 ring-1 ring-inset ring-emerald-200 rounded-full px-3 py-1">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
    Actualizado hoy
  </span>
  <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mt-3">
    Lo más barato hoy en <span class="text-emerald-700"><%= @city %></span>
  </h1>
  <p class="text-slate-500 mt-2 max-w-xl">
    Comparamos precios entre <%= pluralize(Pharmacy.active.count, "farmacia") %> todos los días,
    y calculamos el costo real por miligramo para encontrar la opción más barata de cada medicamento.
  </p>
</div>

<% if @common_offers.empty? && @other_offers.empty? %>
  <div class="bg-white border border-dashed border-slate-300 rounded-2xl p-12 text-center">
    <p class="text-slate-500">Aún no hay precios cargados.</p>
    <p class="text-slate-400 text-sm mt-1">Vuelve más tarde, hoy mismo se ejecutará el primer rastreo.</p>
  </div>
<% else %>
  <% if @common_offers.any? && @page == 1 %>
    <section class="mb-12">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">
          Los más buscados
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @common_offers.each do |offer| %>
          <%= render "offer_row", offer: offer %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @other_offers.any? %>
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">
          Todos los medicamentos
        </h2>
        <span class="text-xs text-slate-400">Página <%= @page %> de <%= @total_pages %></span>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @other_offers.each do |offer| %>
          <%= render "offer_row", offer: offer %>
        <% end %>
      </div>

      <nav class="flex items-center justify-center gap-3 mt-10">
        <% if @page > 1 %>
          <%= link_to "← Anterior", root_path(page: @page - 1),
                class: "px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:border-emerald-300 hover:text-emerald-700 transition-colors" %>
        <% end %>
        <% if @page < @total_pages %>
          <%= link_to "Siguiente →", root_path(page: @page + 1),
                class: "px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:border-emerald-300 hover:text-emerald-700 transition-colors" %>
        <% end %>
      </nav>
    </section>
  <% end %>
<% end %>
