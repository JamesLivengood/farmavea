<%#
  On-site chat. Messages are stored on our server and relayed to the operator's
  phone, so two things matter in this markup:

  1. The credential line states a US nursing licence as a FACT and says plainly it
     does not replace a medical consultation in Mexico. Practising nursing in Mexico
     requires a cedula profesional from the SEP, which a US licence is not. Never
     reword this to "verificada", "certificada en Mexico", or a bare "enfermera
     titulada" - a visitor deciding what to take weighs how authoritative the answer
     looks.
  2. The email field is optional and labelled as such. What people type here is
     health-adjacent, which is sensitive personal data under the LFPDPPP.
%>
<div data-controller="chat"
     data-chat-endpoint-value="<%= chat_path %>"
     class="fixed bottom-5 right-5 z-40 flex flex-col items-end gap-3">

  <div data-chat-target="panel"
       hidden
       class="w-[min(21rem,calc(100vw-2.5rem))] bg-white rounded-2xl border border-slate-200 shadow-xl shadow-slate-900/10 overflow-hidden flex flex-col">

    <div class="bg-emerald-600 px-4 py-3 text-white shrink-0">
      <div class="flex items-center justify-between gap-2">
        <p class="font-semibold text-sm">¿Tienes dudas?</p>
        <%# Live status, so nobody sits waiting on a reply that is hours away. %>
        <span data-chat-target="presence"
              class="inline-flex items-center gap-1.5 text-[11px] font-medium bg-white/15 rounded-full px-2 py-0.5">
          <span data-chat-target="presenceDot" class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
          <span data-chat-target="presenceLabel">—</span>
        </span>
      </div>
      <p data-chat-target="presenceNote" class="text-emerald-50 text-xs mt-0.5">Escríbenos y te respondemos</p>
    </div>

    <div class="px-4 py-2.5 bg-amber-50 border-b border-amber-200 shrink-0">
      <p class="text-[11px] text-slate-700 leading-relaxed">
        <strong class="font-semibold text-amber-900"><%= ChatSettings::DISCLAIMER_HEADING %></strong>
        <%= ChatSettings::DISCLAIMER %>
      </p>
      <p class="text-[11px] text-slate-500 leading-relaxed mt-1.5">
        Atendido por <%= ChatSettings::OPERATOR_DESCRIPTION %>
      </p>
    </div>

    <div data-chat-target="log"
         role="log"
         aria-live="polite"
         class="px-4 py-3 space-y-2.5 overflow-y-auto min-h-[7rem] max-h-72 text-sm">
      <p data-chat-target="empty" class="text-slate-400 text-xs">
        Pregúntanos sobre precios, presentaciones o en qué farmacia encontrar un medicamento.
      </p>
    </div>

    <form data-chat-target="form"
          data-action="chat#send"
          class="border-t border-slate-100 p-3 space-y-2 shrink-0">
      <label class="block">
        <span class="sr-only">Tu mensaje</span>
        <textarea data-chat-target="message"
                  data-action="keydown->chat#maybeSend"
                  rows="2"
                  maxlength="<%= ChatMessage::MAX_LENGTH %>"
                  required
                  placeholder="Escribe tu pregunta…"
                  class="w-full text-sm rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none resize-none"></textarea>
      </label>

      <div data-chat-target="contactRow" class="space-y-1.5">
        <p data-chat-target="contactPrompt" class="text-[11px] text-slate-500 hidden">
          Déjanos tu correo o teléfono y te contactamos en cuanto podamos.
        </p>
        <label class="block">
          <span class="sr-only">Tu correo (opcional)</span>
          <input type="email"
                 data-chat-target="email"
                 placeholder="Tu correo (opcional)"
                 class="w-full text-xs rounded-lg border border-slate-200 px-3 py-1.5 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none">
        </label>
        <label class="block">
          <span class="sr-only">Tu teléfono (opcional)</span>
          <input type="tel"
                 data-chat-target="phone"
                 placeholder="Tu teléfono o WhatsApp (opcional)"
                 class="w-full text-xs rounded-lg border border-slate-200 px-3 py-1.5 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none">
        </label>
      </div>

      <div class="flex items-center justify-between gap-2">
        <p data-chat-target="status" class="text-[11px] text-slate-400" role="status"></p>
        <button type="submit"
                data-chat-target="submit"
                class="bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 text-white text-sm font-semibold rounded-lg px-4 py-2 transition-colors">
          Enviar
        </button>
      </div>

      <%# Repeated at the point of sending: the banner above scrolls out of view once
          a conversation is underway, and this is the moment it needs to be true. %>
      <p class="text-[10px] text-slate-400 leading-snug">
        Al enviar aceptas que este chat no es asesoría médica y que tu mensaje se
        guarda para poder responderte.
        <%= link_to "Aviso de privacidad", privacy_path,
              class: "underline underline-offset-2 hover:text-emerald-600" %>
      </p>
    </form>
  </div>

  <button type="button"
          data-action="chat#toggle"
          data-chat-target="button"
          aria-expanded="false"
          class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-full pl-4 pr-5 py-3 shadow-lg shadow-emerald-900/20 transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span data-chat-target="label">Pregúntanos</span>
    <span data-chat-target="badge"
          hidden
          class="bg-white text-emerald-700 text-[11px] font-bold rounded-full min-w-5 h-5 px-1.5 flex items-center justify-center">1</span>
  </button>
</div>
