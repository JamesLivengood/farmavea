<%# Open Graph / Twitter Card tags, used by WhatsApp, Facebook, Twitter, iMessage,
    Slack and search engines when someone shares a link.

    Pages set :meta_description and :meta_title via content_for; both fall back to
    sensible site-wide defaults so no page ever shares as a blank card. og:url uses
    request.original_url so the shared link resolves to the exact page. %>
<% page_title = content_for(:meta_title).presence || content_for(:title).presence || "Farmavea" %>
<% description = content_for(:meta_description).presence ||
     "Compara precios de medicamentos entre farmacias en Morelia y encuentra la opción más barata por miligramo." %>

<meta name="description" content="<%= strip_tags(description) %>">

<meta property="og:site_name" content="Farmavea">
<meta property="og:type" content="website">
<meta property="og:locale" content="es_MX">
<meta property="og:title" content="<%= strip_tags(page_title) %>">
<meta property="og:description" content="<%= strip_tags(description) %>">
<meta property="og:url" content="<%= canonical_page_url %>">
<meta property="og:image" content="<%= image_url_for_sharing %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<%# summary_large_image gives the wide preview card rather than a small thumbnail. %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= strip_tags(page_title) %>">
<meta name="twitter:description" content="<%= strip_tags(description) %>">
<meta name="twitter:image" content="<%= image_url_for_sharing %>">

<link rel="canonical" href="<%= canonical_page_url %>">
